# Copy to .env (git-ignored). Real environment variables always win over this file.

AGENCY_NAME=[AGENCY]

# Cloudflare Turnstile secret key. Leave empty in local dev to skip spam verification.
TURNSTILE_SECRET=

# Where new-lead notifications are sent. (SMTP + sender are configured in the dashboard: Settings → Mail)
LEADS_NOTIFY_EMAIL=hello@example.com

# Static host deploy hook (Cloudflare Pages / Netlify / Vercel) called after content changes.
DEPLOY_HOOK_URL=
REBUILD_DEBOUNCE=30s

# Optional CRM / automation webhook (HubSpot, Pipedrive, Make, n8n…) that receives each new lead as JSON.
CRM_WEBHOOK_URL=
CRM_API_KEY=
