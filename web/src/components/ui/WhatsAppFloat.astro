---
/**
 * Floating WhatsApp button (phones & tablets). In Morocco most clients prefer WhatsApp to forms.
 * Shown only when PUBLIC_WHATSAPP_NUMBER is set in web/.env (international format, digits only).
 */
import { site } from '../../data/site';
import { getLocale } from '../../i18n/config';

const locale = getLocale(Astro.url);
const text = locale === 'fr' ? 'Bonjour ! J’aimerais parler d’un projet.' : "Hi! I'd like to talk about a project.";
const href = site.whatsapp ? `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(text)}` : undefined;
---

{href && (
  <a
    href={href}
    target="_blank"
    rel="noopener"
    aria-label="WhatsApp"
    class="fixed bottom-5 right-5 z-[70] grid size-14 place-items-center rounded-full bg-[#25D366] text-white shadow-lg transition-transform active:scale-95 lg:hidden"
    onclick="window.dispatchEvent(new CustomEvent('analytics', { detail: { event: 'whatsapp_click', location: 'float' } }))"
  >
    <svg viewBox="0 0 24 24" class="size-7" fill="currentColor" aria-hidden="true">
      <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.24-.7.24-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.5h-.01a9.4 9.4 0 0 1-4.8-1.31l-.34-.2-3.57.93.95-3.48-.22-.36a9.4 9.4 0 0 1-1.44-5.02c0-5.2 4.24-9.43 9.44-9.43 2.52 0 4.89.98 6.67 2.77a9.37 9.37 0 0 1 2.76 6.67c0 5.2-4.24 9.43-9.44 9.43m8.03-17.47A11.28 11.28 0 0 0 12.05.7C5.79.7.7 5.79.7 12.05c0 2 .52 3.95 1.52 5.67L.6 23.4l5.82-1.53a11.3 11.3 0 0 0 5.42 1.38h.01c6.26 0 11.35-5.09 11.35-11.35 0-3.03-1.18-5.88-3.32-8.02" />
    </svg>
  </a>
)}
