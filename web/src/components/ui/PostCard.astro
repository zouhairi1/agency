---
import { Image } from 'astro:assets';
import { getLocale, localizePath } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { formatDate, type LocalizedPost } from '../../lib/content';

interface Props {
  post: LocalizedPost;
  index?: number;
}
const { post, index = 0 } = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const tones = ['from-[#1d2410] to-[#0f0f0f]', 'from-[#10202a] to-[#0f0f0f]', 'from-[#2a1420] to-[#0f0f0f]'];
---

<a href={localizePath(`/blog/${post.slug}`, locale)} class="group flex h-full flex-col">
  <div class="relative aspect-[16/10] overflow-hidden rounded-sm bg-ink-soft">
    {post.cover ? (
      <Image src={post.cover} alt="" width={1600} height={1000} widths={[480, 800, 1200]} sizes="(min-width: 768px) 33vw, 100vw"
        class="size-full object-cover transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-105" loading="lazy" />
    ) : (
      <div class={`flex size-full items-end bg-gradient-to-br p-6 transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-105 ${tones[index % tones.length]}`}>
        <span class="font-display text-2xl leading-tight text-paper/80">{post.title}</span>
      </div>
    )}
  </div>
  <div class="mt-5 flex items-center gap-3 text-xs uppercase tracking-wider text-muted">
    {post.category && <span class="text-accent-text">{t.blog.categories[post.category] ?? post.category}</span>}
    <span>{formatDate(post.date, locale)}</span>
    <span>· {post.readingTime} {t.blog.minRead}</span>
  </div>
  <h3 class="mt-3 font-display text-2xl leading-snug">
    <span class="bg-[linear-gradient(currentColor,currentColor)] bg-[length:0%_1px] bg-left-bottom bg-no-repeat transition-[background-size] duration-500 group-hover:bg-[length:100%_1px]">{post.title}</span>
  </h3>
  <p class="mt-3 text-paper/60">{post.excerpt}</p>
</a>
