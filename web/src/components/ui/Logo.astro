---
/**
 * Agency logo: an 8-pointed zellige star (two interlaced squares, a classic Moroccan geometric motif)
 * with an open centre, drawn as a single minimal shape in the brand colour, next to the wordmark.
 */
import { site } from '../../data/site';

interface Props {
  /** Show the wordmark next to the mark. */
  wordmark?: boolean;
  class?: string;
  size?: string;
}
const { wordmark = true, class: className = '', size = 'size-8' } = Astro.props;
const name = site.name.replace(/^\[|\]$/g, '');
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg viewBox="0 0 32 32" class:list={[size, 'shrink-0 text-accent']} aria-hidden="true">
    <path
      fill="currentColor"
      fill-rule="evenodd"
      d="M31 16 26.61 20.39 26.61 26.61 20.39 26.61 16 31 11.61 26.61 5.39 26.61 5.39 20.39 1 16 5.39 11.61 5.39 5.39 11.61 5.39 16 1 20.39 5.39 26.61 5.39 26.61 11.61ZM20.5 16A4.5 4.5 0 1 0 11.5 16 4.5 4.5 0 1 0 20.5 16Z"
    />
  </svg>
  {wordmark && <span class="font-display text-xl font-semibold tracking-tight">{name}</span>}
</span>
