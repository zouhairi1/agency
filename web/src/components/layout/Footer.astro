---
import { site } from '../../data/site';
import { getLocale, localizePath } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { getNav } from '../../i18n/nav';
import Logo from '../ui/Logo.astro';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const nav = getNav(locale);
const waText = locale === 'fr' ? 'Bonjour ! J’aimerais parler d’un projet.' : "Hi! I'd like to talk about a project.";
const waHref = site.whatsapp ? `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(waText)}` : undefined;
---

<footer class="border-t border-line bg-ink" transition:animate="none">
  <!-- Call to action -->
  <div class="container-x py-24 md:py-32">
    <p class="eyebrow">{t.footer.haveIdea}</p>
    <div class="mt-6 flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between">
      <h2 class="display-lg max-w-[14ch]">{t.ctaBanner.title}</h2>
      <div class="flex flex-wrap gap-3">
        <a href={localizePath('/contact', locale)} data-open-contact="footer"
          class="rounded-full bg-accent px-7 py-4 font-medium text-on-accent transition-colors hover:bg-accent-hover">
          {t.cta.start}
        </a>
        {waHref && (
          <a href={waHref} target="_blank" rel="noopener" class="rounded-full border border-line px-7 py-4 font-medium transition-colors hover:border-paper">
            WhatsApp
          </a>
        )}
      </div>
    </div>
  </div>

  <!-- Links -->
  <div class="container-x grid grid-cols-2 gap-x-6 gap-y-10 border-t border-line py-12 md:py-14 lg:grid-cols-4">
    <div class="col-span-2 lg:col-span-1">
      <p class="eyebrow mb-4">Contact</p>
      <button type="button" data-copy-email={site.email} data-copied={t.ctaBanner.copied} class="py-2 text-left text-lg hover:text-accent-text">
        {site.email}
      </button>
      <p class="mt-2 text-sm text-muted">{t.footer.worldwide}</p>
    </div>

    <nav aria-label={t.footer.sitemap}>
      <p class="eyebrow mb-4">{t.footer.sitemap}</p>
      <ul class="space-y-2">
        {nav.map((item) => <li><a href={item.href} class="inline-block py-1.5 text-paper/80 hover:text-paper">{item.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <p class="eyebrow mb-4">{t.footer.social}</p>
      <ul class="space-y-2">
        {site.socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener" class="inline-block py-1.5 text-paper/80 hover:text-paper">{s.label}</a></li>)}
      </ul>
    </div>

    <div>
      <p class="eyebrow mb-4">{t.footer.offices}</p>
      <ul class="space-y-2 text-paper/80">
        {site.offices.map((o) => (
          <li>{o.city[locale]} · <time data-local-time={o.timeZone} class="tabular-nums">--:--</time></li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Wordmark: an SVG text stretched to the container width, so it always fits. -->
  <div class="container-x" aria-hidden="true">
    <svg viewBox="0 0 1000 150" class="w-full text-paper/[0.06]" preserveAspectRatio="xMidYMid meet">
      <text x="0" y="128" textLength="1000" lengthAdjust="spacingAndGlyphs" class="fill-current font-display" style="font-size: 160px; font-weight: 600; letter-spacing: -0.04em;">
        {site.name.replace(/^\[|\]$/g, '')}
      </text>
    </svg>
  </div>

  <!-- Bottom bar -->
  <div class="container-x flex flex-wrap items-center justify-between gap-4 border-t border-line py-6 text-sm text-muted">
    <div class="flex items-center gap-4">
      <Logo wordmark={false} size="size-6" />
      <p>© {new Date().getFullYear()} {site.name.replace(/^\[|\]$/g, '')}. {t.footer.rights}</p>
    </div>
    <a href="#main" class="inline-block py-2 hover:text-paper">{t.footer.backToTop}</a>
  </div>

  <p data-copy-toast role="status" aria-live="polite" class="pointer-events-none fixed bottom-8 left-1/2 z-[80] -translate-x-1/2 translate-y-4 rounded-full bg-paper px-5 py-3 text-sm text-ink opacity-0 transition-all duration-300"></p>
</footer>

<script>
  // Live local time + copy email (footer persists through the page fade, so bind on every page load).
  const tick = () => {
    for (const el of document.querySelectorAll<HTMLElement>('[data-local-time]')) {
      el.textContent = new Intl.DateTimeFormat('fr-MA', { hour: '2-digit', minute: '2-digit', timeZone: el.dataset.localTime }).format(new Date());
    }
  };
  setInterval(tick, 30_000);

  document.addEventListener('astro:page-load', () => {
    tick();
    const toast = document.querySelector<HTMLElement>('[data-copy-toast]');
    for (const btn of document.querySelectorAll<HTMLElement>('[data-copy-email]')) {
      if (btn.dataset.bound) continue;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', async () => {
        await navigator.clipboard?.writeText(btn.dataset.copyEmail ?? '');
        if (!toast) return;
        toast.textContent = btn.dataset.copied ?? '';
        toast.classList.remove('opacity-0', 'translate-y-4');
        setTimeout(() => toast.classList.add('opacity-0', 'translate-y-4'), 1800);
      });
    }
  });
</script>
