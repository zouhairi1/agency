---
import { founders } from '../../data/site';
import { getLocale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import Logo from '../ui/Logo.astro';

const t = useTranslations(getLocale(Astro.url));
const people = t.founders.people.map((p, i) => ({ ...p, ...founders[i] }));
---

<!-- Being two is a selling point: direct access to the people who build. -->
<section class="section border-t border-line" aria-labelledby="founders-title">
  <div class="container-x grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <p class="eyebrow">{t.founders.label}</p>
      <h2 id="founders-title" class="display-lg mt-4" data-reveal="lines">{t.founders.title}</h2>
      <p class="lead mt-5">{t.founders.sub}</p>
    </div>

    <ul class="grid gap-5 sm:grid-cols-2 lg:col-span-7">
      {people.map((person) => (
        <li class="rounded-sm border border-line bg-ink-soft p-6 md:p-8" data-reveal="fade">
          <div class="aspect-[4/3] overflow-hidden rounded-sm bg-ink">
            {person.photo ? (
              <img src={person.photo} alt={person.name} class="size-full object-cover" loading="lazy" />
            ) : (
              <div class="grid size-full place-items-center bg-[radial-gradient(circle_at_50%_40%,color-mix(in_srgb,var(--color-accent)_18%,transparent),transparent_70%)]">
                <Logo wordmark={false} size="size-14 opacity-80" />
              </div>
            )}
          </div>
          {person.name && <p class="mt-6 font-display text-2xl font-medium">{person.name}</p>}
          <p class:list={['text-sm text-accent-text', person.name ? 'mt-1' : 'mt-6']}>{person.role}</p>
          <p class="mt-3 text-paper/65">{person.text}</p>
          {person.linkedin && (
            <a href={person.linkedin} target="_blank" rel="noopener" class="mt-4 inline-block py-2 text-sm underline underline-offset-4">LinkedIn ↗</a>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
