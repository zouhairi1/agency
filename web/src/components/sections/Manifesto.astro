---
import { getLocale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations(getLocale(Astro.url));
---

<!-- Who we are: one short statement + three pillars (simple, readable on every screen). -->
<section class="section border-t border-line" aria-labelledby="about-title">
  <div class="container-x">
    <p class="eyebrow">{t.manifesto.label}</p>
    <h2 id="about-title" class="display-lg mt-4 max-w-2xl" data-reveal="lines">{t.manifesto.text}</h2>

    <ul class="mt-14 grid gap-px overflow-hidden rounded-sm border border-line bg-line md:grid-cols-3">
      {t.manifesto.pillars.map((pillar, i) => (
        <li class="bg-ink p-8 md:p-10" data-reveal="fade" data-reveal-delay={String(i * 0.1)}>
          <span class="text-sm tabular-nums text-accent-text">0{i + 1}</span>
          <h3 class="mt-6 font-display text-2xl font-medium">{pillar.title}</h3>
          <p class="mt-3 text-paper/65">{pillar.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
