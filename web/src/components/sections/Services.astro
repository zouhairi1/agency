---
import { getLocale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
  services: { title: string; outcome: string; capabilities: string[]; icon?: string }[];
}
const { services } = Astro.props;
const t = useTranslations(getLocale(Astro.url));
---

<section id="services" class="section" aria-labelledby="services-title">
  <div class="container-x">
    <div class="mb-14 max-w-3xl">
      <p class="eyebrow">{t.services.label}</p>
      <h2 id="services-title" class="display-lg mt-4" data-reveal="lines">{t.services.title}</h2>
    </div>

    <ul class="border-t border-line">
      {services.map((service, i) => (
        <li class="border-b border-line" data-preview-src={service.icon} data-reveal="fade">
          <details class="group">
            <summary class="relative flex cursor-pointer list-none items-center gap-3 overflow-hidden py-5 md:gap-6 md:py-8 [&::-webkit-details-marker]:hidden">
              <span class="absolute inset-0 -z-10 origin-bottom scale-y-0 bg-paper/5 transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:scale-y-100" aria-hidden="true"></span>
              <span class="w-7 shrink-0 text-xs text-muted tabular-nums md:w-12 md:text-sm">0{i + 1}</span>
              <span class="flex-1 font-display text-xl font-medium leading-snug tracking-tight sm:text-2xl md:text-4xl">{service.title}</span>
              <span class="hidden max-w-xs text-muted lg:block">{service.outcome}</span>
              <span class="grid size-10 shrink-0 place-items-center rounded-full border border-line text-lg transition-transform duration-500 ease-[var(--ease-out-expo)] group-open:rotate-45 md:size-12 md:text-xl" aria-hidden="true">+</span>
            </summary>
            <div class="grid gap-5 pb-8 pl-10 md:grid-cols-2 md:gap-6 md:pb-10 md:pl-18">
              <p class="text-paper/70 lg:hidden">{service.outcome}</p>
              <ul class="flex flex-wrap gap-2">
                {service.capabilities.map((c) => <li class="rounded-full border border-line px-4 py-1.5 text-sm">{c}</li>)}
              </ul>
            </div>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Smooth height animation for <details> where supported. */
  details { interpolate-size: allow-keywords; }
  details::details-content {
    height: 0;
    overflow: clip;
    transition: height 600ms var(--ease-out-expo), content-visibility 600ms allow-discrete;
  }
  details[open]::details-content { height: auto; }
  @media (prefers-reduced-motion: reduce) {
    details::details-content { transition: none; }
  }
</style>
