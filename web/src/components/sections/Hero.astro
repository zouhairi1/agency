---
import { getLocale, localizePath } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
---

<section class="relative flex min-h-[88svh] items-center overflow-hidden pb-20 pt-32 md:pt-40" aria-labelledby="hero-title">
  <!-- Soft background glow (always) + WebGL blob on the right (desktop, lazy-loaded). -->
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(55%_60%_at_80%_45%,color-mix(in_srgb,var(--color-accent)_14%,transparent)_0%,transparent_70%)]" aria-hidden="true"></div>
  <canvas data-hero-canvas class="absolute inset-0 -z-10 size-full opacity-0" aria-hidden="true"></canvas>

  <div class="container-x">
    <div class="max-w-3xl">
      <p class="eyebrow mb-6" data-reveal="fade" data-reveal-immediate data-reveal-delay="0.1">{t.hero.eyebrow}</p>
      <h1 id="hero-title" class="display-xl" data-reveal="lines" data-reveal-immediate data-reveal-delay="0.2">
        {t.hero.title}
      </h1>
      <p class="lead mt-8 max-w-xl" data-reveal="fade" data-reveal-immediate data-reveal-delay="0.6">{t.hero.sub}</p>

      <div class="mt-10 flex flex-wrap gap-3" data-reveal="fade" data-reveal-immediate data-reveal-delay="0.8">
        <a href={localizePath('/contact', locale)} data-open-contact="hero"
          class="rounded-full bg-accent px-7 py-3.5 font-medium text-on-accent transition-colors hover:bg-accent-hover">
          {t.cta.start}
        </a>
        <a href={localizePath('/work', locale)} class="rounded-full border border-line px-7 py-3.5 font-medium transition-colors hover:border-paper/50">
          {t.cta.seeWork}
        </a>
      </div>

      <ul class="mt-12 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted" data-reveal="fade" data-reveal-immediate data-reveal-delay="1">
        {t.hero.trust.map((item) => (
          <li class="flex items-center gap-2">
            <svg viewBox="0 0 16 16" class="size-4 text-accent-text" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m3.5 8.5 3 3 6-7" /></svg>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
