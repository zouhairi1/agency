---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/ui/PostCard.astro';
import { getLocale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { getPosts } from '../lib/content';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const posts = await getPosts(locale);
---

<BaseLayout title={t.blog.pageTitle} description={t.blog.pageDescription}>
  <section class="container-x pb-24 pt-40">
    <p class="eyebrow">{t.blog.label}</p>
    <h1 class="display-xl mt-4" data-reveal="lines" data-reveal-immediate>{t.blog.title}</h1>
    <p class="mt-8 max-w-xl text-lg text-paper/70">{t.blog.pageDescription}</p>

    <ul class="mt-20 grid gap-x-8 gap-y-16 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post, i) => <li><PostCard post={post} index={i} /></li>)}
    </ul>
  </section>
</BaseLayout>
