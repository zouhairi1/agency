# Copy to .env (git-ignored)

# Public site URL (used for sitemap + canonical URLs)
SITE_URL=https://example.com

# PocketBase API (local: run `.\pocketbase.exe serve` in /backend)
PUBLIC_PB_URL=http://127.0.0.1:8090

# Cloudflare Turnstile site key (leave empty in local dev)
PUBLIC_TURNSTILE_SITE_KEY=

# WhatsApp number in international format, digits only (e.g. 212600000000)
PUBLIC_WHATSAPP_NUMBER=

# Contact email shown on the site
PUBLIC_CONTACT_EMAIL=hello@example.com

# Cal.com booking link
PUBLIC_BOOKING_URL=https://cal.com/your-agency/intro
